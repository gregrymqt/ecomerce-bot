# ==============================================================================
# 🤖 E-commerce Bot — Master Environment Variables (.env.example)
# ==============================================================================
# Este arquivo serve como Fonte Canônica de Referência para todas as variáveis
# de ambiente utilizadas no ecossistema (Core API .NET, Worker AI Python, Web SPA React,
# Runner de Migrações SQL Server e Infraestrutura Docker).
#
# Para uso local: Copie este arquivo para .env na raiz ou configure as variáveis
# correspondentes no seu ambiente / orquestrador.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 AMBIENTE GLOBAL E APLICAÇÃO
# ------------------------------------------------------------------------------
ENVIRONMENT=development
# Opções: development, staging, production

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# URLs base da plataforma
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
App__BaseUrl=https://app.ecommercebot.com
App__FrontendUrl=http://localhost:5173

# CORS: Domínios autorizados separados por vírgula ou JSON array
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]


# ------------------------------------------------------------------------------
# 🗄️ BANCO DE DADOS: MICROSOFT SQL SERVER 2022 (DAPPER & DBUP)
# ------------------------------------------------------------------------------
# Senha de administrador SA do SQL Server (Docker)
MSSQL_SA_PASSWORD=YourStrong@Passw0rdDev
MSSQL_PID=Developer

# Connection String utilizada pelo Core API (.NET) e Database.Migrations (DbUp)
# Em Docker/Linux na VPS: Server=localhost,1433;Database=EcommerceBotDb;User Id=sa;Password=...;TrustServerCertificate=True;
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=EcommerceBotDb;User Id=sa;Password=YourStrong@Passw0rdDev;TrustServerCertificate=True;Encrypt=False;
MSSQL_CONNECTION_STRING=Server=localhost,1433;Database=EcommerceBotDb;User Id=sa;Password=YourStrong@Passw0rdDev;TrustServerCertificate=True;Encrypt=False;


# ------------------------------------------------------------------------------
# 🐘 BANCO DE DADOS: POSTGRESQL (LEGADO / WORKER PYTHON FALLBACK)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=ecommerce_bot_db
POSTGRES_URI=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/ecommerce_bot_db
POSTGRES_URI_TRANSACTION=
POSTGRES_URI_SESSION=
DB_SSL_CERT_PATH=


# ------------------------------------------------------------------------------
# ⚡ CACHE & SSE STREAM: REDIS
# ------------------------------------------------------------------------------
# Connection string do Redis utilizada pelo Core API
ConnectionStrings__Redis=localhost:6379,abortConnect=false
Redis__ConnectionString=localhost:6379,abortConnect=false
Redis__Password=

# URL do Redis para o Worker Python
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=


# ------------------------------------------------------------------------------
# 📬 BROKER DE MENSAGERIA: RABBITMQ (MASSTRANSIT & AIO-PIKA)
# ------------------------------------------------------------------------------
# Configurações do RabbitMQ para o Core (.NET MassTransit)
RabbitMQ__Host=localhost
RabbitMQ__Username=guest
RabbitMQ__Password=guest
RabbitMQ__Port=5672
RabbitMQ__VirtualHost=/

# URL AMQP utilizada pelo Worker Python (aio-pika)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest


# ------------------------------------------------------------------------------
# 🔒 AUTENTICAÇÃO, TOKENS JWT & CRIPTOGRAFIA (FAIL-CLOSED)
# ------------------------------------------------------------------------------
# Chave Secreta Simétrica para assinatura de JWT (mínimo de 32 caracteres / 256 bits)
# ⚠️ OBRIGATÓRIO em Produção. NUNCA use a chave de exemplo abaixo em produção!
Jwt__Key=DevOnly_EcommerceBotSecureSigningKey_Minimum32CharsLong!
Jwt__Issuer=EcommerceBotApi
Jwt__Audience=EcommerceBotClient
Jwt__ExpireMinutes=1440
JWT_SECRET_KEY=DevOnly_EcommerceBotSecureSigningKey_Minimum32CharsLong!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Chave Mestre Hexadecimal para criptografia AES-256 GCM (BYOK) - 64 caracteres hexadecimais (32 bytes)
# Gere uma com: openssl rand -hex 32
Security__AesMasterKey=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Chave de autorização de serviços internos (X-Internal-Secret) para telemetria e metering
Security__InternalServiceKey=dev_internal_secret_key_change_in_prod

# Lista de e-mails com privilégio de ADMIN (separados por vírgula ou JSON array)
ADMIN_EMAILS=admin@ecommercebot.com


# ------------------------------------------------------------------------------
# 💳 GATEWAY DE PAGAMENTO: MERCADO PAGO
# ------------------------------------------------------------------------------
# Token de Acesso Privado da API Mercado Pago
MercadoPago__AccessToken=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Secret para validação criptográfica (HMAC-SHA256) dos Webhooks do Mercado Pago
MercadoPago__WebhookSecret=your_mercadopago_webhook_secret_here
MERCADOPAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret_here

# Chave Pública para inicialização do SDK JS no Frontend (Checkout Transparente)
MercadoPago__PublicKey=TEST-00000000-0000-0000-0000-000000000000
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000


# ------------------------------------------------------------------------------
# 📧 SERVIÇO DE E-MAIL TRANSACIONAL: RESEND
# ------------------------------------------------------------------------------
# Flag para habilitar ou desabilitar envio (true/false)
Resend__Enabled=true
RESEND_ENABLED=true

# Modo de entrega: "Mock" (simulado nos logs/banco), "LogOnly" ou "Live" (API Resend)
Resend__DeliveryMode=Mock
RESEND_DELIVERY_MODE=Mock

# Chave de API do Resend (ex: re_123456789). Se vazia ou re_test123, opera em modo simulado
Resend__ApiKey=re_test123
RESEND_API_KEY=re_test123

# Secret para verificação de assinatura Svix nos Webhooks do Resend
Resend__WebhookSecret=whsec_your_resend_svix_secret_here

# Remetente padrão dos e-mails disparados
Resend__FromEmail=ECom AutoBot <notificacoes@ecommercebot.com>
EMAIL_FROM=ECom AutoBot <notificacoes@ecommercebot.com>


# ------------------------------------------------------------------------------
# 🛍️ INTEGRAÇÃO E-COMMERCE: SHOPIFY (GRAPHQL & OAUTH)
# ------------------------------------------------------------------------------
Shopify__ClientId=your_shopify_client_id
Shopify__ClientSecret=your_shopify_client_secret
Shopify__WebhookSecret=your_shopify_webhook_secret
Shopify__Scopes=read_products,write_products,read_inventory,write_inventory
Shopify__RedirectUri=https://app.ecommercebot.com/api/v1/shopify/oauth/callback
Shopify__ApiVersion=2026-07
Shopify__AppUrl=https://app.ecommercebot.com

SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory
SHOPIFY_REDIRECT_URI=https://app.ecommercebot.com/api/v1/shopify/oauth/callback
SHOPIFY_API_VERSION=2026-07


# ------------------------------------------------------------------------------
# 🏬 INTEGRAÇÃO E-COMMERCE: NUVEMSHOP (REST & OAUTH)
# ------------------------------------------------------------------------------
Nuvemshop__ClientId=your_nuvemshop_client_id
Nuvemshop__ClientSecret=your_nuvemshop_client_secret
Nuvemshop__WebhookSecret=your_nuvemshop_webhook_secret
Nuvemshop__RedirectUri=https://app.ecommercebot.com/api/v1/nuvemshop/oauth/callback
Nuvemshop__WebhookCallbackUrl=https://app.ecommercebot.com/api/v1/nuvemshop/webhooks
Nuvemshop__Scopes=write_products,read_products,write_orders,read_orders

NUVEMSHOP_CLIENT_ID=your_nuvemshop_client_id
NUVEMSHOP_CLIENT_SECRET=your_nuvemshop_client_secret
NUVEMSHOP_WEBHOOK_SECRET=your_nuvemshop_webhook_secret
NUVEMSHOP_REDIRECT_URI=https://app.ecommercebot.com/api/v1/nuvemshop/oauth/callback
NUVEMSHOP_SCOPES=write_products,read_products,write_orders,read_orders


# ------------------------------------------------------------------------------
# 🔑 AUTENTICAÇÃO SOCIAL: GOOGLE OAUTH 2.0
# ------------------------------------------------------------------------------
Google__ClientId=mock_google_client_id.apps.googleusercontent.com
Google__ClientSecret=mock_google_client_secret
Google__RedirectUri=http://localhost:5173/auth/google/callback

GOOGLE_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback


# ------------------------------------------------------------------------------
# 🧠 AI / ML ENGINE & PROVEDORES LLM (WORKER PYTHON)
# ------------------------------------------------------------------------------
# Chaves dos provedores de IA
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Roteamento inteligente de modelos e fallbacks
DEFAULT_PRIMARY_MODEL=deepseek/deepseek-chat
DEFAULT_FALLBACK_MODEL_1=groq/llama-3.3-70b-versatile
DEFAULT_FALLBACK_MODEL_2=google/gemini-2.0-flash-001

# Limite de saldo baixo para alerta de créditos gerenciados
LOW_BALANCE_THRESHOLD=10

# ------------------------------------------------------------------------------
# 🚨 ALERTAS CRÍTICOS DE SISTEMA & DEVOPS: DISCORD WEBHOOKS
# ------------------------------------------------------------------------------
# Webhook URL para notificação em tempo real de erros 500, DLQs e falhas críticas
Discord__WebhookUrl=
DISCORD_WEBHOOK_URL=



# ------------------------------------------------------------------------------
# 🖥️ FRONTEND WEB SPA (REACT + VITE)
# ------------------------------------------------------------------------------
# URL base da API Core consumida pelo navegador
VITE_API_URL=http://localhost:8000

# Chaves de Analytics e Monitoramento no Frontend
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=


# ------------------------------------------------------------------------------
# ☁️ BACKUP RESILIENTE CLOUDFLARE R2 & MANUTENÇÃO (VPS PROD)
# ------------------------------------------------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=ecommercebot-sqlserver-backups
BACKUP_ENCRYPTION_PASSWORD=
