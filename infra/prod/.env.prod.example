# ==============================================================================
# 🤖 E-commerce Bot — Master Environment Variables para Produção (.env.prod)
# ==============================================================================
# Copie este arquivo para infra/prod/.env.prod na VPS e preencha com as credenciais reais de produção.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 AMBIENTE GLOBAL E APLICAÇÃO
# ------------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://api.ecommercebot.com
FRONTEND_URL=https://app.ecommercebot.com
App__BaseUrl=https://api.ecommercebot.com
App__FrontendUrl=https://app.ecommercebot.com
CORS_ORIGINS=["https://app.ecommercebot.com","https://ecommercebot.com"]

# ------------------------------------------------------------------------------
# 🗄️ BANCO DE DADOS: MICROSOFT SQL SERVER 2022 (DAPPER & DBUP)
# ------------------------------------------------------------------------------
MSSQL_SA_PASSWORD=ChangeMe_StrongProductionPassword_2026!
MSSQL_PID=Enterprise
MSSQL_DB=EcommerceBotDb
MSSQL_CONTAINER=prod-mssql-bot
MSSQL_CONNECTION_STRING=Server=mssql,1433;Database=EcommerceBotDb;User Id=sa;Password=ChangeMe_StrongProductionPassword_2026!;TrustServerCertificate=True;Encrypt=False;
ConnectionStrings__DefaultConnection=Server=mssql,1433;Database=EcommerceBotDb;User Id=sa;Password=ChangeMe_StrongProductionPassword_2026!;TrustServerCertificate=True;Encrypt=False;

# ------------------------------------------------------------------------------
# ⚡ CACHE & SSE STREAM: REDIS
# ------------------------------------------------------------------------------
REDIS_PASSWORD=ChangeMe_RedisProductionPassword_2026!
REDIS_URL=redis://:ChangeMe_RedisProductionPassword_2026!@redis:6379/0
ConnectionStrings__Redis=redis:6379,password=ChangeMe_RedisProductionPassword_2026!,abortConnect=false
Redis__ConnectionString=redis:6379,password=ChangeMe_RedisProductionPassword_2026!,abortConnect=false
Redis__Password=ChangeMe_RedisProductionPassword_2026!

# ------------------------------------------------------------------------------
# 📬 BROKER DE MENSAGERIA: RABBITMQ (MASSTRANSIT & AIO-PIKA)
# ------------------------------------------------------------------------------
RABBITMQ_USER=ecommerce_prod_user
RABBITMQ_PASS=ChangeMe_RabbitProductionPassword_2026!
RABBITMQ_URL=amqp://ecommerce_prod_user:ChangeMe_RabbitProductionPassword_2026!@rabbitmq:5672/
RabbitMQ__Host=rabbitmq
RabbitMQ__Username=ecommerce_prod_user
RabbitMQ__Password=ChangeMe_RabbitProductionPassword_2026!
RabbitMQ__Port=5672
RabbitMQ__VirtualHost=/

# ------------------------------------------------------------------------------
# 🔒 AUTENTICAÇÃO, TOKENS JWT & CRIPTOGRAFIA (FAIL-CLOSED)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=Production_EcommerceBotSecureSigningKey_ChangeMeImmediatelyInProduction_Min32Chars!
Jwt__Key=Production_EcommerceBotSecureSigningKey_ChangeMeImmediatelyInProduction_Min32Chars!
Jwt__Issuer=EcommerceBotApi
Jwt__Audience=EcommerceBotClient
Jwt__ExpireMinutes=1440
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
Security__AesMasterKey=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
INTERNAL_SERVICE_KEY=prod_internal_secret_key_change_me_immediately
Security__InternalServiceKey=prod_internal_secret_key_change_me_immediately

ADMIN_EMAILS=admin@ecommercebot.com
Security__SuperAdminEmails=admin@ecommercebot.com

# ------------------------------------------------------------------------------
# 💳 GATEWAY DE PAGAMENTO: MERCADO PAGO
# ------------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_WEBHOOK_SECRET=prod_mercadopago_webhook_secret_here
MERCADOPAGO_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000
MercadoPago__AccessToken=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
MercadoPago__WebhookSecret=prod_mercadopago_webhook_secret_here
MercadoPago__PublicKey=APP_USR-00000000-0000-0000-0000-000000000000
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------------------------
# 📧 SERVIÇO DE E-MAIL TRANSACIONAL: RESEND
# ------------------------------------------------------------------------------
RESEND_ENABLED=true
RESEND_DELIVERY_MODE=Live
RESEND_API_KEY=re_live_production_key_here
RESEND_WEBHOOK_SECRET=whsec_prod_resend_svix_secret_here
EMAIL_FROM=ECom AutoBot <notificacoes@ecommercebot.com>
Resend__Enabled=true
Resend__DeliveryMode=Live
Resend__ApiKey=re_live_production_key_here
Resend__WebhookSecret=whsec_prod_resend_svix_secret_here
Resend__FromEmail=ECom AutoBot <notificacoes@ecommercebot.com>

# ------------------------------------------------------------------------------
# 🛍️ INTEGRAÇÃO E-COMMERCE: SHOPIFY (GRAPHQL & OAUTH)
# ------------------------------------------------------------------------------
SHOPIFY_CLIENT_ID=prod_shopify_client_id
SHOPIFY_CLIENT_SECRET=prod_shopify_client_secret
SHOPIFY_WEBHOOK_SECRET=prod_shopify_webhook_secret
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory
SHOPIFY_REDIRECT_URI=https://api.ecommercebot.com/api/v1/shopify/oauth/callback
SHOPIFY_API_VERSION=2026-07
SHOPIFY_APP_URL=https://app.ecommercebot.com
Shopify__ClientId=prod_shopify_client_id
Shopify__ClientSecret=prod_shopify_client_secret
Shopify__WebhookSecret=prod_shopify_webhook_secret
Shopify__Scopes=read_products,write_products,read_inventory,write_inventory
Shopify__RedirectUri=https://api.ecommercebot.com/api/v1/shopify/oauth/callback
Shopify__ApiVersion=2026-07
Shopify__AppUrl=https://app.ecommercebot.com

# ------------------------------------------------------------------------------
# 🏬 INTEGRAÇÃO E-COMMERCE: NUVEMSHOP (REST & OAUTH)
# ------------------------------------------------------------------------------
NUVEMSHOP_CLIENT_ID=prod_nuvemshop_client_id
NUVEMSHOP_CLIENT_SECRET=prod_nuvemshop_client_secret
NUVEMSHOP_WEBHOOK_SECRET=prod_nuvemshop_webhook_secret
NUVEMSHOP_REDIRECT_URI=https://api.ecommercebot.com/api/v1/nuvemshop/oauth/callback
NUVEMSHOP_WEBHOOK_CALLBACK_URL=https://api.ecommercebot.com/api/v1/nuvemshop/webhooks
NUVEMSHOP_SCOPES=write_products,read_products,write_orders,read_orders
Nuvemshop__ClientId=prod_nuvemshop_client_id
Nuvemshop__ClientSecret=prod_nuvemshop_client_secret
Nuvemshop__WebhookSecret=prod_nuvemshop_webhook_secret
Nuvemshop__RedirectUri=https://api.ecommercebot.com/api/v1/nuvemshop/oauth/callback
Nuvemshop__WebhookCallbackUrl=https://api.ecommercebot.com/api/v1/nuvemshop/webhooks
Nuvemshop__Scopes=write_products,read_products,write_orders,read_orders

# ------------------------------------------------------------------------------
# 🔑 AUTENTICAÇÃO SOCIAL: GOOGLE OAUTH 2.0
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=prod_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=prod_google_client_secret
GOOGLE_REDIRECT_URI=https://app.ecommercebot.com/auth/google/callback
Google__ClientId=prod_google_client_id.apps.googleusercontent.com
Google__ClientSecret=prod_google_client_secret
Google__RedirectUri=https://app.ecommercebot.com/auth/google/callback

# ------------------------------------------------------------------------------
# 🧠 AI / ML ENGINE & PROVEDORES LLM (WORKER PYTHON)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-prod_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DEFAULT_PRIMARY_MODEL=deepseek/deepseek-chat
DEFAULT_FALLBACK_MODEL_1=groq/llama-3.3-70b-versatile
DEFAULT_FALLBACK_MODEL_2=google/gemini-2.0-flash-001
LOW_BALANCE_THRESHOLD=10

# ------------------------------------------------------------------------------
# 🚨 ALERTAS CRÍTICOS DE SISTEMA & DEVOPS: DISCORD WEBHOOKS
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_prod_webhook_here
Discord__WebhookUrl=https://discord.com/api/webhooks/your_prod_webhook_here

# ------------------------------------------------------------------------------
# ☁️ BACKUP RESILIENTE CLOUDFLARE R2 & MANUTENÇÃO (VPS PROD)
# ------------------------------------------------------------------------------
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=ecommercebot-sqlserver-backups
BACKUP_ENCRYPTION_PASSWORD=your_backup_encryption_password_here
