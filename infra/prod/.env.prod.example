# ========================================================
# AMBIENTE DE PRODUÇÃO (PROD) - VPS InterServer + Cloud
# ========================================================

# Banco de Dados Microsoft SQL Server 2022 (Local Docker VPS)
MSSQL_SA_PASSWORD=insira_uma_senha_forte_para_o_sqlserver_aqui
MSSQL_PID=Developer
MSSQL_DB=EcommerceBotDb
MSSQL_CONTAINER=prod-mssql-bot
MSSQL_CONNECTION_STRING=Server=mssql,1433;Database=EcommerceBotDb;User Id=sa;Password=insira_uma_senha_forte_para_o_sqlserver_aqui;TrustServerCertificate=True;Encrypt=False;

# Mensageria RabbitMQ (Local Docker VPS)
RABBITMQ_USER=guest
RABBITMQ_PASS=insira_uma_senha_forte_para_o_rabbitmq_aqui
RABBITMQ_URL=amqp://guest:insira_uma_senha_forte_para_o_rabbitmq_aqui@rabbitmq:5672/

# Cache & Streaming SSE (Redis Local na VPS via Docker)
REDIS_PASSWORD=insira_uma_senha_forte_para_o_redis_aqui
REDIS_URL=redis://:insira_uma_senha_forte_para_o_redis_aqui@redis:6379/0

# Cloudflare R2 - Credenciais de Backup do SQL Server 2022 (S3 API)
R2_ACCOUNT_ID=seu_account_id_da_cloudflare
R2_ACCESS_KEY_ID=sua_chave_de_acesso_r2
R2_SECRET_ACCESS_KEY=sua_chave_secreta_r2
R2_BUCKET_NAME=ecommerce-bot-backups

# Criptografia BYOK (AES-256 GCM)
# OBRIGATÓRIO: Gerar chave mestra de 32 bytes em Base64 para cifrar chaves dos tenants
# Comando para gerar: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
AES_MASTER_KEY=insira_sua_chave_mestre_base64_gerada_aqui

# Autenticação JWT de Produção
JWT_SECRET_KEY=insira_seu_jwt_secret_super_seguro_aqui
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Provedores de Inteligência Artificial (Worker AI Engine)
DEEPSEEK_API_KEY=sk-sua-chave-deepseek-prod
GROQ_API_KEY=gsk_sua-chave-groq-prod
OPENAI_API_KEY=sk-sua-chave-openai-prod
OPENROUTER_API_KEY=sk-or-v1-sua-chave-openrouter-prod

# Mercado Pago - Credenciais de Produção
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token-producao
MERCADOPAGO_WEBHOOK_SECRET=seu-secret-webhook-mercadopago

# E-mails Transacionais (Resend & Jinja2)
RESEND_ENABLED=true
RESEND_DELIVERY_MODE=Live
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
DEFAULT_FROM_EMAIL=ECom AutoBot <atendimento@ecomautobot.com>
LOW_BALANCE_THRESHOLD=10

# Integrações E-commerce (Shopify & Nuvemshop)
SHOPIFY_CLIENT_ID=seu_shopify_client_id
SHOPIFY_CLIENT_SECRET=seu_shopify_client_secret
SHOPIFY_WEBHOOK_SECRET=seu_shopify_webhook_secret
NUVEMSHOP_CLIENT_ID=seu_nuvemshop_client_id
NUVEMSHOP_CLIENT_SECRET=seu_nuvemshop_client_secret
NUVEMSHOP_WEBHOOK_SECRET=seu_nuvemshop_webhook_secret

# Alertas Críticos (Discord Webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/seu_webhook_de_alertas_prod

# Configurações do Ambiente de Execução
ENVIRONMENT=production
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["https://app.seudominio.com","https://seudominio.com"]
