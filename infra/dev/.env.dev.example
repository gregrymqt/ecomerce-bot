# ========================================================
# AMBIENTE DE DESENVOLVIMENTO (DEV) - E-commerce Bot
# ========================================================

# Configurações do Microsoft SQL Server 2022 Local & DbUp
MSSQL_SA_PASSWORD=YourStrong@Passw0rdDev
MSSQL_PID=Developer
MSSQL_DB=EcommerceBotDb
MSSQL_CONNECTION_STRING=Server=localhost,1433;Database=EcommerceBotDb;User Id=sa;Password=YourStrong@Passw0rdDev;TrustServerCertificate=True;Encrypt=False;

# Mensageria RabbitMQ Local
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Cache & Streaming SSE (Redis Local)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Criptografia BYOK (AES-256 GCM)
# Chave mestra de 32 bytes codificada em Base64 para cifrar credenciais dos tenants
AES_MASTER_KEY=sua_chave_mestre_base64_32bytes_aqui

# Autenticação JWT
JWT_SECRET_KEY=sua_chave_secreta_jwt_dev_super_segura

# Provedores de Inteligência Artificial (Fallback Global)
DEEPSEEK_API_KEY=sk-sua-chave-deepseek
GROQ_API_KEY=gsk_sua-chave-groq
OPENAI_API_KEY=sk-sua-chave-openai

# Notificações e Webhooks de Alerta
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/seu_webhook_dev

# E-mails Transacionais (Resend & Jinja2)
RESEND_ENABLED=true
RESEND_DELIVERY_MODE=Mock
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
DEFAULT_FROM_EMAIL=ECom AutoBot <atendimento@ecomautobot.com>
LOW_BALANCE_THRESHOLD=10

# Configurações do Servidor FastAPI
ENVIRONMENT=development
LOG_LEVEL=DEBUG
