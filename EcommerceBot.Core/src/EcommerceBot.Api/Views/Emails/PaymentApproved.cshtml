@model EcommerceBot.Application.ViewModels.Emails.PaymentApprovedEmailViewModel

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pagamento Aprovado</title>
    <style>
        body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #0f172a; color: #f8fafc; }
        .container { max-width: 600px; margin: 40px auto; background-color: #1e293b; border-radius: 12px; overflow: hidden; border: 1px solid #334155; }
        .header { background: linear-gradient(135deg, #10b981 0%, #059669 100%); padding: 32px; text-align: center; }
        .header h1 { margin: 0; color: #ffffff; font-size: 24px; font-weight: 700; }
        .content { padding: 32px; line-height: 1.6; color: #cbd5e1; }
        .content h2 { color: #ffffff; font-size: 20px; margin-top: 0; }
        .receipt-card { background-color: #0f172a; border-radius: 8px; padding: 20px; margin: 24px 0; border: 1px solid #334155; }
        .receipt-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #1e293b; font-size: 14px; }
        .receipt-row:last-child { border-bottom: none; font-weight: 700; color: #34d399; font-size: 16px; margin-top: 8px; }
        .btn-wrapper { text-align: center; margin: 32px 0; }
        .btn { display: inline-block; background-color: #10b981; color: #ffffff !important; font-weight: 600; text-decoration: none; padding: 14px 28px; border-radius: 8px; font-size: 16px; }
        .footer { padding: 24px; text-align: center; font-size: 12px; color: #64748b; border-top: 1px solid #334155; background-color: #0f172a; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>✅ Pagamento Confirmado</h1>
        </div>
        <div class="content">
            <h2>Olá, @Model.RecipientName!</h2>
            <p>Seu pagamento foi processado e aprovado com sucesso. Seus créditos e acesso ao plano já estão disponíveis.</p>
            
            <div class="receipt-card">
                <div class="receipt-row">
                    <span style="color:#94a3b8;">Item / Plano:</span>
                    <span>@Model.PlanName</span>
                </div>
                <div class="receipt-row">
                    <span style="color:#94a3b8;">Método de Pagamento:</span>
                    <span>@Model.PaymentMethod</span>
                </div>
                <div class="receipt-row">
                    <span style="color:#94a3b8;">ID da Transação:</span>
                    <span style="font-family:monospace;">@Model.TransactionId</span>
                </div>
                <div class="receipt-row">
                    <span>Total Pago:</span>
                    <span>R$ @Model.Amount.ToString("N2")</span>
                </div>
            </div>

            <div class="btn-wrapper">
                <a href="@Model.DashboardUrl" class="btn" target="_blank">Acessar Dashboard</a>
            </div>

            <p style="font-size: 14px; color: #94a3b8;">Obrigado por confiar no E-commerce Bot!</p>
        </div>
        <div class="footer">
            <p>&copy; @Model.Year E-commerce Bot. Todos os direitos reservados.</p>
        </div>
    </div>
</body>
</html>
