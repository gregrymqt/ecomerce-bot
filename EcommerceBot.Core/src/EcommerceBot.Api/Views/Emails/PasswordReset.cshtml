@model EcommerceBot.Application.ViewModels.Emails.PasswordResetEmailViewModel

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redefinição de Senha — E-commerce Bot</title>
    <style>
        body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #0b0f19; color: #f8fafc; }
        .container { max-width: 580px; margin: 40px auto; background-color: #0b0f19; border-radius: 16px; overflow: hidden; border: 1px solid #1e293b; padding: 32px; box-sizing: border-box; }
        .header { text-align: center; margin-bottom: 28px; }
        .header h1 { font-size: 24px; font-weight: 700; color: #6366f1; margin: 0; }
        .header p { color: #94a3b8; font-size: 14px; margin-top: 4px; }
        .card { background: #1e293b; border-radius: 12px; padding: 24px; margin-bottom: 24px; border: 1px solid #334155; }
        .card h2 { font-size: 18px; font-weight: 600; color: #f1f5f9; margin-top: 0; }
        .card p { color: #cbd5e1; font-size: 14px; line-height: 1.6; }
        .btn-wrapper { text-align: center; margin: 28px 0; }
        .btn { background: #6366f1; color: #ffffff !important; text-decoration: none; padding: 12px 28px; border-radius: 8px; font-size: 15px; font-weight: 600; display: inline-block; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4); }
        .security-note { color: #64748b; font-size: 12px; line-height: 1.5; margin-bottom: 0; }
        .footer { text-align: center; border-top: 1px solid #1e293b; padding-top: 20px; }
        .footer p { color: #64748b; font-size: 12px; margin: 0; }
        .footer a { color: #818cf8; word-break: break-all; font-size: 11px; text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>E-commerce Bot</h1>
            <p>Recuperação de Acesso à Conta</p>
        </div>
        <div class="card">
            <h2>Olá, @Model.RecipientName!</h2>
            <p>
                Recebemos uma solicitação para redefinir a senha da sua conta no <strong>E-commerce Bot</strong>.
            </p>
            <p>
                Clique no botão abaixo para escolher uma nova senha segura. Este link expira em <strong>@Model.ExpiresInMinutes minutos</strong> e só pode ser utilizado uma única vez.
            </p>
            <div class="btn-wrapper">
                <a href="@Model.ResetUrl" class="btn" target="_blank">
                    Redefinir Minha Senha
                </a>
            </div>
            <p class="security-note">
                Se você não solicitou esta redefinição, fique tranquilo: sua conta continua segura e você pode ignorar esta mensagem com total segurança.
            </p>
        </div>
        <div class="footer">
            <p>
                Link direto caso o botão não funcione:<br/>
                <a href="@Model.ResetUrl">@Model.ResetUrl</a>
            </p>
            <p style="margin-top: 12px; font-size: 11px; color: #475569;">
                &copy; @Model.Year E-commerce Bot. Todos os direitos reservados.
            </p>
        </div>
    </div>
</body>
</html>
