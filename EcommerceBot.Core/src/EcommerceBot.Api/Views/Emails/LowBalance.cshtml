@model EcommerceBot.Application.ViewModels.Emails.LowBalanceEmailViewModel

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alerta de Saldo Baixo</title>
    <style>
        body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #0f172a; color: #f8fafc; }
        .container { max-width: 600px; margin: 40px auto; background-color: #1e293b; border-radius: 12px; overflow: hidden; border: 1px solid #334155; }
        .header { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); padding: 32px; text-align: center; }
        .header h1 { margin: 0; color: #ffffff; font-size: 24px; font-weight: 700; }
        .content { padding: 32px; line-height: 1.6; color: #cbd5e1; }
        .content h2 { color: #ffffff; font-size: 20px; margin-top: 0; }
        .alert-card { background-color: #0f172a; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #f59e0b; border-top: 1px solid #334155; border-right: 1px solid #334155; border-bottom: 1px solid #334155; }
        .btn-wrapper { text-align: center; margin: 32px 0; }
        .btn { display: inline-block; background-color: #f59e0b; color: #ffffff !important; font-weight: 600; text-decoration: none; padding: 14px 28px; border-radius: 8px; font-size: 16px; }
        .footer { padding: 24px; text-align: center; font-size: 12px; color: #64748b; border-top: 1px solid #334155; background-color: #0f172a; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>⚠️ Saldo de IA Quase Esgotado</h1>
        </div>
        <div class="content">
            <h2>Olá, @Model.RecipientName!</h2>
            <p>Identificamos que o seu saldo de créditos para inferência de modelos gerenciados de IA está abaixo do limite de segurança.</p>
            
            <div class="alert-card">
                <p style="margin: 0; font-size: 15px;">
                    Seu saldo atual é de <strong style="color: #fbbf24; font-size: 18px;">R$ @Model.CurrentBalance.ToString("N2")</strong> (limite de alerta: R$ @Model.Threshold.ToString("N2")).
                </p>
                <p style="margin: 8px 0 0 0; font-size: 13px; color: #94a3b8;">
                    Para evitar que suas rotinas de enriquecimento de produtos e scraping sejam pausadas, faça uma recarga.
                </p>
            </div>

            <div class="btn-wrapper">
                <a href="@Model.RechargeUrl" class="btn" target="_blank">Recarregar Créditos Agora</a>
            </div>

            <p style="font-size: 14px; color: #94a3b8;">Você também pode optar por configurar sua própria chave de API (BYOK) no menu de configurações a qualquer momento.</p>
        </div>
        <div class="footer">
            <p>&copy; @Model.Year E-commerce Bot. Todos os direitos reservados.</p>
        </div>
    </div>
</body>
</html>
